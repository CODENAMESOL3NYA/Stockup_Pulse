# Environment Configuration for StockUp Pulse
# AMD Hackathon ACT III - Reinvent Commerce

# AMD Radeon Cloud Token Factory (OpenAI compatible; disabled until configured)
AMD_ROCM_ENABLED="false"
AMD_ROCM_HOST="https://developer.amd.com.cn/radeon/api/v1"
AMD_ROCM_API_KEY=""
# Set an exact model ID exposed by your AMD endpoint (required when enabled):
# DeepSeek-V4.1-Flash, DeepSeek-V4-Flash, DeepSeek-V4-Flash-Vision-Exp,
# GLM-5.3-Flash, MiMo-V2.6-Flash, MinerU2.5-Pro, MiniCPM5-2B,
# MiniCPM-V-4.7-1B, MiniCPM-V-4.7-35B-A3B, Qwen3.8-27B, Qwen3.8-Flash-Next
AMD_ROCM_MODEL=""
AMD_ROCM_DEVICE="not_configured"
AMD_ROCM_VERSION="not_configured"

# Evolus PDF workflow API (disabled until credentials and workflow are configured)
EVOLUS_ENABLED="false"
EVOLUS_API_KEY=""
EVOLUS_APPLICATION_ID=""
EVOLUS_WORKFLOW_ID=""
EVOLUS_ENDPOINT="https://api.evolus.ai/api/v1"
EVOLUS_EXECUTION_TIMEOUT_SECONDS=120
EVOLUS_POLL_INTERVAL_SECONDS=2

# WhatsApp Business / Twilio API (inbound webhook disabled until configured)
WHATSAPP_PROVIDER="twilio" # or "meta"
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_WHATSAPP_NUMBER="whatsapp:+14155238886"
OWNER_PHONE_NUMBER=""
TWILIO_WEBHOOK_ENABLED="false"
TWILIO_WEBHOOK_PUBLIC_URL=""
OUTBOUND_SUPPLIER_DISPATCH_ENABLED="false"

# JSON object of explicitly configured supplier lead times, e.g. {"Makro":2}
SUPPLIER_LEAD_TIMES='{}'

# Gemini API (Fallback & Vision Parsing)
GEMINI_API_KEY=""

# Store Defaults
STORE_NAME="Sunnyside Spaza"
STORE_LOCATION="Pretoria Central, Gauteng, South Africa"
DEFAULT_BUDGET_ZAR=3000.00
DEFAULT_PLANNING_HORIZON_DAYS=14

# Browser origins are a JSON array parsed by pydantic-settings.
CORS_ORIGINS='["http://localhost:3000", "http://127.0.0.1:3000"]'

# Server Config
API_HOST="127.0.0.1"
API_PORT=8000
STREAMLIT_PORT=8501
