# Environment Configuration for StockUp Pulse
# AMD Hackathon ACT III - Reinvent Commerce

# AMD ROCm / vLLM Endpoint (OpenAI compatible)
AMD_ROCM_HOST=""
AMD_ROCM_API_KEY=""
AMD_ROCM_MODEL="Qwen/Qwen2.5-VL-7B-Instruct"
AMD_ROCM_DEVICE="not_configured"
AMD_ROCM_VERSION="not_configured"

# Evolus Building Blocks API
EVOLUS_API_KEY=""
EVOLUS_ENDPOINT="https://api.evolus.ai/v1"

# WhatsApp Business / Twilio API
WHATSAPP_PROVIDER="twilio" # or "meta"
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_WHATSAPP_NUMBER="whatsapp:+14155238886"
OWNER_PHONE_NUMBER=""

# Gemini API (Fallback & Vision Parsing)
GEMINI_API_KEY=""

# Store Defaults
STORE_NAME="Sunnyside Spaza"
STORE_LOCATION="Pretoria Central, Gauteng, South Africa"
DEFAULT_BUDGET_ZAR=3000.00
DEFAULT_PLANNING_HORIZON_DAYS=14

# Browser origins are a JSON array parsed by pydantic-settings.
CORS_ORIGINS='["http://localhost:3000", "http://127.0.0.1:3000"]'

# Server Config
API_HOST="127.0.0.1"
API_PORT=8000
STREAMLIT_PORT=8501
